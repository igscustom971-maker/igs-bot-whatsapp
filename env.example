# Clé API Claude (depuis console.anthropic.com)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxx

# Token de vérification webhook (généré dans Dualhook, tu choisis n'importe quelle chaîne secrète)
DUALHOOK_VERIFY_TOKEN=ton-token-secret-ici

# Credentials WhatsApp via Dualhook (Coexistence)
DUALHOOK_API_KEY=dh_live_xxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxx

# Email où recevoir les récaps de leads
EMAIL_TO=contact@igscustom.fr

# Supabase (historique de conversation, prénoms clients, notes, réglages persistants)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=ta-cle-service-role-ici

# Numéro perso d'Ismaël (pour récap et alertes urgentes), format international sans +
RECAP_PHONE_NUMBER=590690XXXXXX

# Clé secrète perso pour le panel admin
ADMIN_TOKEN=ton-token-secret

# Format YYYY-MM-DD : bot totalement désactivé jusqu'à cette date incluse (optionnel)
CLOSED_UNTIL=
